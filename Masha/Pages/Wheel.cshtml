@page
@using Domain.Wheel
@model WheelModel
@{
    ViewData["Title"] = "Казино-рояль";
}

<div id="sidebar">
    <select id="select-wheel"
            class="form-select"
            aria-label="Default select example">
        <option value="0" selected>Выберите</option>
        @foreach (WheelList list in Model.Lists!)
        {
            <option value="@list.Guid">@list.Name</option>
        }
    </select>

    <div id="new-wheel-list-input">
        <input id="new-list-name"
               class="form-control"
               type="text"
               placeholder="Наименование нового списка"
               aria-label="default input example">

        <button id="add-wheel-list-btn"
                class="btn btn-success"
                onclick="wheelList.add()">
            Добавить список
        </button>
    </div>
</div>

<div id="wheel">

</div>

<div id="wheel-modal" class="modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="modal-word"
                    class="modal-title">
                    Word here
                </h5>
            </div>
            <div id="modal-definition"
                 class="modal-body blur">
                Definition here
            </div>
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-primary"
                        id="open-definition-btn"
                        onclick="wheelList.openDefinition()">
                    Open definition
                </button>
                <button type="button"
                        id="modal-close-btn"
                        class="btn btn-secondary d-none"
                        onclick="wheelList.hideModal()">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>