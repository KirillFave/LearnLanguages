@page
@using WebApp.ViewModels.Schemes

@model SchemesModel
@{
    ViewData["Title"] = "Схемы";
}

@section Scripts {
    <script src="js/schemes.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/schemes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/addSchemeItemPopover.css" asp-append-version="true" />
}

<div class="grid-container">
    @for (int row = 1; row <= 9; row++)
    {
        @for (int column = 1; column <= 15; column++)
        {
            string cellContent = $"{(char)('A' + column - 1)}{row}";

            <div class="grid-item scheme-item"
                 data-row="@row"
                 data-column="@column">
                @cellContent
            </div>
        }
    }
</div>

@await Html.PartialAsync("~/Views/Schemes/_AddSchemeItemPopover.cshtml")