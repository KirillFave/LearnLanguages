@using WebApp.ViewModels.Schemes

@model SchemeVM

<div class="grid-container">
    @for (int row = 1; row <= 9; row++)
    {
        @for (int column = 1; column <= 15; column++)
        {
            SchemeItemVM? item = Model.ItemVMs.FirstOrDefault(x => x.Row == row && x.Column == column);

            if (item is null)
            {
                <div class="grid-item scheme-item"
                     data-row="@row"
                     data-column="@column">
                </div>
            }
            else 
            {
                @await Html.PartialAsync("~/Views/Schemes/_SchemeItemBadge.cshtml", item)
            }
        }
    }
</div>