<div id="add-scheme-item-popover"
     class="d-none position-absolute">
    <div class="heading">Add item</div>
    <form class="form" action="">
        <div class="input-field">
            <input required=""
                   autocomplete="off"
                   type="text"
                   id="title-input"
                   name="title-input"/>
            <label for="title-input">Title</label>
        </div>
        <div class="input-field">
            <input required=""
                   autocomplete="off"
                   type="text"
                   id="text-input"
                   name="text-input"/>
            <label for="text-input">Text</label>
        </div>

        <button id="confirm-add-item-btn" class="btn">
            Confirm
        </button>
    </form>
</div>
