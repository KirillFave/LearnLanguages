@model Guid

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div id="add-scheme-item-popover"
     class="d-none position-absolute">
    <div class="heading">Add item</div>
    <form class="form" method="post" asp-page-handler="AddItem">
        <input hidden value="@Model" name="AddSchemeItemDto.SchemeGuid" />
        <input hidden id="input-row" value="" name="AddSchemeItemDto.Row" />
        <input hidden id="input-column" value="" name="AddSchemeItemDto.Column" />

        <div class="input-field">
            <input required=""
                   autocomplete="off"
                   type="text"
                   id="title-input"
                   name="AddSchemeItemDto.Title" />
            <label for="title-input">Title</label>
        </div>

        <div class="input-field">
            <input required=""
                   autocomplete="off"
                   type="text"
                   id="translation-input"
                   name="AddSchemeItemDto.Translation" />
            <label for="translation-input">Translation</label>
        </div>

        <div class="input-field">
            <input required=""
                   autocomplete="off"
                   type="text"
                   id="text-input"
                   name="AddSchemeItemDto.Text"/>
            <label for="text-input">Text</label>
        </div>

        <div class="d-flex">
            <label for="color-input"
                   class="d-block me-2">
                Color
            </label>
            <input type="color"
                   id="color-input"
                   value="#007FFF"
                   name="AddSchemeItemDto.Color" />
        </div>

        <button id="confirm-add-item-btn" class="btn" type="submit">
            Confirm
        </button>
    </form>
</div>
